<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 下载前台服务:API 34 起需 dataSync 类型权限(下载属于数据传输) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application>
        <!-- 下载保活前台服务:有任务下载中时运行,通知栏展示进度;无任务自动停止 -->
        <!-- 类名必须写全:相对名 .download.X 会按模块 namespace(com.github.tvbox.osc.download)展开成
             com.github.tvbox.osc.download.download.X,而真实类在 ...download.internal,服务永远起不来 -->
        <service
            android:name="com.github.tvbox.osc.download.internal.DownloadForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>
