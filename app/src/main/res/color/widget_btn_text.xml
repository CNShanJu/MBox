<?xml version="1.0" encoding="utf-8"?>
<!-- 小组件按钮的文字色(与 selector_widget_btn 成对):
     选中 = 实心底上的主按钮文字；
     未选中 = **文字主色**(btn_plain_text 派生自 brand)。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/text_disable" />
    <item android:state_selected="true" android:color="@color/btn_select_text" />
    <item android:color="@color/btn_plain_text" />
</selector>
