<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/item"
    android:layout_width="match_parent"
    android:layout_height="120dp"
    android:foreground="?android:selectableItemBackground"
    android:orientation="horizontal"
    android:paddingHorizontal="10dp">


    <CheckBox
        android:id="@+id/cb"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintBottom_toBottomOf="@id/item"
        app:layout_constraintLeft_toLeftOf="@id/item"
        app:layout_constraintTop_toTopOf="@id/item" />

    <!-- 封面:视频内容截图(适配器异步取关键帧;取帧前/取不到一律用统一占位组件铺背景层,
         见 util/PosterPlaceholderDrawable)。
         这里只给一层纯灰底:方形占位图(96dp/160dp)放进 156×88dp 的 16:9 封面槽,
         无论 fitCenter(缩成居中方块、四周留白)还是 centerCrop(放大裁掉)都不对,
         所以布局层不放占位图,交给按宿主尺寸自适应的统一占位(背景层),src 只放关键帧 -->
    <com.lihang.ShadowLayout
        android:id="@+id/iv_container"
        android:layout_width="156dp"
        android:layout_height="88dp"
        android:layout_gravity="center_horizontal"
        android:baselineAlignBottom="true"
        app:clickable="false"
        app:hl_cornerRadius="@dimen/common_corners"
        app:hl_layoutBackground="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/cb"
        app:layout_constraintTop_toTopOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/iv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_small_round_gray"
                android:clipToOutline="true"
                android:scaleType="centerCrop" />

            <View
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:background="@drawable/bg_gradient_black_b2t"
                android:layout_alignParentBottom="true"/>

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                tools:progress="50"
                android:layout_alignParentBottom="true"
                android:progressDrawable="@drawable/bg_progressbar" />

        </RelativeLayout>
    </com.lihang.ShadowLayout>

    <!-- 剧名/文件名(主标题,颜色由适配器设置:主题主文字色,播放过置灰)。
         行高固定 120dp,而"只有文件名 + 文件大小"的行(本地视频列表:集数/来源都隐藏)中间那一大段是空的,
         所以标题最多给 3 行 —— 以前 maxLines=1,长文件名直接截成省略号,右边下面全是留白。
         用 bottom_toTopOf(tv_video_size) + layout_constrainedHeight 兜底:标题再长也只占满
         "文件大小"之上的空间,不会盖住底部那行;字号被系统放大/文件名极长时由 ConstraintLayout
         压住可用高度,TextView 自己末行省略。vertical_bias=0 保证标题仍然贴顶生长
         (只加上边约束时是贴顶,补了下边约束若不置 0 会变成在这段空间里垂直居中)。
         带集数/来源的行(下载完成 tab)由适配器把 maxLines 压回 1:那种行标题一撑高就会把
         下面两行挤出 120dp 的行高。 -->
    <TextView
        android:id="@+id/tv_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="14dp"
        android:ellipsize="end"
        android:gravity="start"
        android:maxLines="3"
        android:textColor="@color/text_foreground"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/tv_video_size"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_container"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"
        tools:text="花开锦绣2026" />

    <!-- 集数 -->
    <TextView
        android:id="@+id/tv_episode"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text_sub_foreground"
        android:textSize="12sp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_container"
        app:layout_constraintTop_toBottomOf="@+id/tv_name"
        tools:text="集数：1" />

    <!-- 来源 -->
    <TextView
        android:id="@+id/tv_source"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text_sub_foreground"
        android:textSize="12sp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_container"
        app:layout_constraintTop_toBottomOf="@+id/tv_episode"
        tools:text="📺热播┃多线" />

    <!-- 时长(封面左下,覆盖在渐变上) -->
    <TextView
        android:id="@+id/tv_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:layout_marginBottom="7dp"
        android:textColor="@color/white"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_container"
        app:layout_constraintStart_toStartOf="@+id/iv_container"
        tools:text="00:00" />

    <!-- 文件大小(整数,224MB) -->
    <TextView
        android:id="@+id/tv_video_size"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="14dp"
        android:textColor="@color/text_sub_foreground"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_container"
        tools:text="224MB" />


</androidx.constraintlayout.widget.ConstraintLayout>
