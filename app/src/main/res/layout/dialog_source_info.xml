<?xml version="1.0" encoding="utf-8"?>
<!-- 来源信息弹窗:收藏/历史卡片点"来源徽标"弹出。主题面板底(bg_dialog → bg_float),文字走主题色。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- 标题行:标题居左、关闭键居右上角,两者垂直居中对齐(关闭键尺寸走全站统一的 DialogCloseButton)。
         高度必须 wrap_content 让 28dp 关闭键完整容纳,固定高度会压掉关闭键的内边距(图标贴边/被裁剪)。 -->
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

        <TextView
                android:id="@+id/tv_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="订阅信息"
                android:textColor="@color/text_foreground"
                android:textSize="17sp"
                android:textStyle="bold"/>

        <ImageView
                android:id="@+id/iv_close"
                style="@style/DialogCloseButton"
                android:contentDescription="关闭"
                app:tint="@color/text_foreground"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_vod"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/text_sub_foreground"
        android:textSize="13sp"
        tools:text="剧名：影片名称" />

    <TextView
        android:id="@+id/tv_subscription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/text_sub_foreground"
        android:textSize="13sp"
        tools:text="订阅源：xxx" />

    <TextView
        android:id="@+id/tv_source"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/text_sub_foreground"
        android:textSize="13sp"
        tools:text="站点：xxx" />

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/text_sub_foreground"
        android:textSize="13sp"
        tools:text="状态说明" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_use"
        style="@style/BtnPrimary"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="end"
        android:layout_marginTop="12dp"
        android:minWidth="140dp"
        android:text="使用目标订阅源" />

</LinearLayout>
