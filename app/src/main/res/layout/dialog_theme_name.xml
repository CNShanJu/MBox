<?xml version="1.0" encoding="utf-8"?>
<!-- 主题命名弹窗:标题 + 说明 + 输入框 + 取消/确定。
     重名时**不关闭弹窗**,就地提示,用户改完再点确定(用户口径:重名要求重新起一个,也允许取消)。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:padding="@dimen/dp_20">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="主题名称"
        android:textColor="@color/text_foreground"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingExtra="2dp"
        android:text="给这个主题起个名字(最多 6 个字,不可与已有主题重名)"
        android:textColor="@color/text_sub_foreground"
        android:textSize="12sp" />

    <!-- 输入框与「直播源」配置弹窗同款:OutlinedBox.Dense 描边框 + 悬浮 hint -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:textColorHint="@color/text_sub_foreground">

        <EditText
            android:id="@+id/et_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:hint="例如:暗夜紫"
            android:inputType="text"
            android:maxLength="6"
            android:maxLines="1"
            android:textColor="@color/text_foreground"
            android:textSize="14sp"
            tools:ignore="Autofill,LabelFor" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/tv_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/text_danger"
        android:textSize="12sp"
        android:visibility="gone"
        tools:text="已有同名主题,请换一个名称"
        tools:visibility="visible" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_15"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel"
            style="@style/BtnSecondary"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="取消" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_ok"
            style="@style/BtnPrimary"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="@dimen/dp_10"
            android:layout_weight="1"
            android:text="确定" />
    </LinearLayout>
</LinearLayout>
