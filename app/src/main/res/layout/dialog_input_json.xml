<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:paddingStart="30dp"
    android:paddingEnd="30dp"
    android:paddingTop="20dp"
    android:paddingBottom="20dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tv_title"
            android:text="JSON 导入"
            android:textColor="@color/text_foreground"
            android:layout_width="wrap_content"
            android:textSize="16sp"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"/>

        <TextView style="@style/WidgetBtn"
            android:id="@+id/tv_paste"
            android:text="粘贴"
            android:layout_width="wrap_content"
            android:textSize="14sp"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            />
    </RelativeLayout>

    <!-- 说明与格式示例分两行:比塞进输入框 hint 更清楚,也不会在框里折行显得像"输出了两遍" -->
    <TextView
        android:id="@+id/tv_tip"
        android:text="粘贴订阅清单/多线路/多仓 JSON，或整份配置内容"
        android:textColor="@color/text_sub_foreground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="12sp"/>

    <TextView
        android:id="@+id/tv_format"
        android:text="清单示例：[{&quot;name&quot;:&quot;订阅名&quot;,&quot;url&quot;:&quot;订阅地址&quot;}]"
        android:textColor="@color/text_sub_foreground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:alpha="0.75"
        android:fontFamily="monospace"
        android:textSize="11sp"/>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
        app:boxStrokeColor="@color/text_main_half"
        app:placeholderTextColor="@color/text_main_half"
        app:hintTextColor="@color/text_main_half"
        app:hintEnabled="false">

        <EditText
            android:id="@+id/et_json"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:background="@null"
            android:clipToPadding="true"
            android:fontFamily="monospace"
            android:gravity="top|start"
            android:hint="在此粘贴或输入 JSON"
            android:textColorHint="@color/text_main_half"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textNoSuggestions"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:scrollbars="vertical"
            android:textColor="@color/text_foreground"
            android:textSize="12sp"/>

    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_height="33dp"
            android:layout_marginRight="20dp"
            android:text="取 消"
            style="@style/BtnSecondary"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_confirm"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_height="33dp"
            style="@style/BtnPrimary"
            android:text="导 入"/>

    </LinearLayout>
</LinearLayout>
