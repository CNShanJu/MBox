<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.github.tvbox.osc.ui.kit.AppTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="缓存管理"
        app:titleBold="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_large_round_float"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="总缓存大小"
            android:textColor="@color/text_sub_foreground"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_total_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="计算中…"
            android:textColor="@color/text_foreground"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_size_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_sub_foreground"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_selection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:text="缓存分类"
        android:textColor="@color/text_foreground"
        android:textSize="15sp" />

    <!-- 圆角属于固定的卡片视口；列表只在卡片内部滚动，底部圆角始终可见。 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_large_round_float"
        android:clipToOutline="true">

        <!-- 留出不可滚入的四周间距；内容回弹，外层卡片及其圆角保持原位。 -->
        <com.github.tvbox.osc.ui.kit.RubberBandScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="8dp"
            android:layout_marginVertical="12dp"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingVertical="8dp"
            android:scrollbars="none"
            app:rubber_target="content">

            <LinearLayout
                android:id="@+id/category_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </com.github.tvbox.osc.ui.kit.RubberBandScrollView>
    </FrameLayout>

    <com.github.tvbox.osc.ui.kit.SelectActionBar
        android:id="@+id/select_action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />
</LinearLayout>
