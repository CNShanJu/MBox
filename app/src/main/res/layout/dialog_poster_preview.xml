<?xml version="1.0" encoding="utf-8"?>
<!-- 海报大图:黑底铺满 + 可缩放 PhotoView。轻点任意位置关闭(见 PosterPreviewView) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/poster_viewer_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:clickable="true"
    android:focusable="true">

    <com.lxj.xpopup.photoview.PhotoView
        android:id="@+id/pv_poster"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:scaleType="fitCenter" />

    <ProgressBar
        android:id="@+id/pb_poster"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:indeterminateTint="@android:color/white" />

    <TextView
        android:id="@+id/tv_poster_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="32dp"
        android:alpha="0.7"
        android:text="轻点关闭 · 双指缩放"
        android:textColor="@android:color/white"
        android:textSize="13sp" />
</FrameLayout>
