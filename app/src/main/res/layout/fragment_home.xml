<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/topLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="44dp"
        android:paddingHorizontal="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/nameContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.github.tvbox.osc.ui.kit.SizedIconTextView
                android:id="@+id/tvName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="110dp"
                android:text="@string/app_name"
                android:textAlignment="gravity"
                android:textColor="@color/text_foreground"
                android:textSize="16dp"
                android:drawablePadding="6dp"
                android:singleLine="true"
                android:drawableRight="@drawable/ic_arrow_down"
                app:drawableTint="@color/text_foreground"
                app:drawableIconSize="24dp"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:focusable="true"
                android:focusableInTouchMode="true"
                />

        </LinearLayout>

        <!-- 提示文字色与底栏"未选中"文字/图标同色(同一个主题键 text_hint):
             不写这一项时会落到 Material 默认的 hint 前景色,一旦主题色板或 Material 版本变化两边就会不一致。
             底用 bg_search_round_float(搜索框专用圆角档 radius_search):这条搜索框是胶囊造型的搜索条,
             圆角是对的、且**不跟着面板档走** —— 别再换回 bg_large_round_float(那会跟页面卡片共用一个值)。 -->
        <com.github.tvbox.osc.ui.kit.SizedIconTextView
            android:id="@+id/search"
            android:layout_width="wrap_content"
            android:layout_weight="1"
            android:layout_height="36dp"
            android:background="@drawable/bg_search_round_float"
            android:gravity="center_vertical"
            android:paddingHorizontal="12sp"
            android:hint="搜索"
            android:textColorHint="@color/text_hint"
            android:drawableTint="@color/gray_darker"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="6dp"
            android:drawableRight="@drawable/ic_search"
            app:drawableIconSize="16dp"/>

        <ImageView
            android:id="@+id/iv_collect"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_collect_48"/>

        <ImageView
            android:id="@+id/iv_history"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_history_48"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/contentLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <com.angcyo.tablayout.DslTabLayout
            android:id="@+id/tab_layout"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            app:tab_indicator_drawable="@drawable/indicator_flash"
            app:tab_indicator_enable_flash="true"
            app:tab_indicator_enable_flash_clip="true"
            app:tab_indicator_height="5dp"
            app:tab_indicator_width="16dp"
            app:tab_select_color="@color/colorPrimary"
            app:tab_deselect_color="@color/text_sub_foreground"
            app:tab_text_min_size="14dp"
            app:tab_text_max_size="16dp"
            app:tab_enable_gradient_text_size="false"
            android:layout_marginTop="6dp"
            >

        </com.angcyo.tablayout.DslTabLayout>

        <androidx.viewpager.widget.ViewPager
            android:id="@+id/mViewPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="10dp"
            />
    </LinearLayout>
</LinearLayout>