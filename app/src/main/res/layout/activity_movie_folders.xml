<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.github.tvbox.osc.ui.kit.AppTitleBar
        android:id="@+id/title_bar"
        app:title="本地视频"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        />

    <!-- 列表卡片:margin 是卡片与屏幕/标题栏的间距,padding 是卡片内部留白。
         clipToPadding=true:滚动内容不越过 padding,行滚到卡片上下边时被截断,始终留着 10dp 内边距 ——
         之前是 false,行会一直滚到卡片的圆角边上(= "贴边滚动,没有内边距")。 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_large_round_float"
        android:layout_margin="10dp"
        android:padding="10dp"
        tools:listitem="@layout/item_folder"
        tools:itemCount="3"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        android:clipToPadding="true" />

    <!-- 长按多选操作栏:公共组件(与下载页同款)。背景/键色/透明度全部由组件按主题取,
         以前这里写死 android:background="@color/white" —— 暗色主题下就是一条白杠,也不吃主题的面透明度。
         动作键由页面现加(VideoListActivity 加 全选/删除/取消全选;合集页当前没有多选删除,故一直隐藏)。 -->
    <com.github.tvbox.osc.ui.kit.SelectActionBar
        android:id="@+id/select_action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        tools:visibility="visible" />
</LinearLayout>
