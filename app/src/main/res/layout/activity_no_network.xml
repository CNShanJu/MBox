<?xml version="1.0" encoding="utf-8"?>
<!-- 网络不可用页:文字/按钮全部走主题资源(text_main·text_sub 文字;按钮走全局样式
     BtnPrimary/BtnSecondary —— 底色/文字色/圆角/描边都取自 theme_colors.json 的 btn_* 与 theme_radii.json),
     **不要**在这里手写 android:background + textColor:Material 按钮会套主题 backgroundTint,手写背景会被盖掉
     (实测:次按钮文字与底色同色 → "看不见字")。
     根部**不设不透明背景**:BaseActivity 的页面背景层(PageBackgroundView)是插在内容容器最底层的,
     自带底色会把用户自定义背景图盖掉(其它页面同理,底色由背景层/窗口主题给)。
     可滚动组件按 AGENTS §六保留内边距并 clipToPadding=false(TV/横屏小高度下内容不贴边、不裁死)。 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingLeft="24dp"
    android:paddingRight="24dp"
    android:paddingTop="24dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_no_network" />

        <TextView
            android:id="@+id/tv_no_network_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="@string/no_network_title"
            android:textColor="@color/text_main"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_no_network_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/no_network_hint"
            android:textColor="@color/text_sub"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_no_network_back"
                style="@style/BtnSecondary"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="140dp"
                android:text="@string/no_network_back" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_no_network_got_it"
                style="@style/BtnPrimary"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="12dp"
                android:minWidth="140dp"
                android:text="@string/no_network_got_it" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
