<?xml version="1.0" encoding="utf-8"?>
<!-- 网络不可用页:整页走主题资源(text_main·text_sub 文字 / colorPrimary 主色按钮 /
     bg_r_common_solid_primary·bg_r_common_stroke_primary 按钮底,后两者内部取 colorPrimary 与圆角),
     **不要**在这里写死颜色与圆角 —— theme_colors.json 改色后这里必须自动跟随。
     根部**不设不透明背景**:BaseActivity 的页面背景层(PageBackgroundView)是插在内容容器最底层的,
     自带底色会把用户自定义背景图盖掉(其它页面同理,底色由背景层/窗口主题给)。
     可滚动组件按 AGENTS §六保留内边距并 clipToPadding=false(TV/横屏小高度下内容不贴边、不裁死)。 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingLeft="24dp"
    android:paddingRight="24dp"
    android:paddingTop="24dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_no_network" />

        <TextView
            android:id="@+id/tv_no_network_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="@string/no_network_title"
            android:textColor="@color/text_main"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_no_network_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/no_network_hint"
            android:textColor="@color/text_sub"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_no_network_back"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/bg_r_common_stroke_primary"
                android:minWidth="120dp"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:text="@string/no_network_back"
                android:textColor="@color/colorPrimary"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btn_no_network_got_it"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="16dp"
                android:background="@drawable/bg_r_common_solid_primary"
                android:minWidth="120dp"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:text="@string/no_network_got_it"
                android:textColor="@color/btn_confirm_text"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
