<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.github.tvbox.osc.ui.kit.AppTitleBar
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="扫描连接二维码"
        app:titleBold="true" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="12dp"
        android:text="对准另一台 MBox 的“生成二维码”，扫描后会填入地址和配对码。"
        android:textColor="@color/text_foreground"
        android:textSize="14sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="14dp"
        android:layout_weight="1"
        android:background="@android:color/black">

        <TextureView
            android:id="@+id/qrCameraPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <View
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_lan_scan_frame"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvScanStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minHeight="48dp"
        android:paddingHorizontal="18dp"
        android:text="正在打开相机…"
        android:textColor="@color/text_sub_foreground"
        android:textSize="13sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRetryScan"
        style="@style/BtnSecondary"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginHorizontal="18dp"
        android:layout_marginBottom="18dp"
        android:text="重新打开相机"
        android:visibility="gone" />
</LinearLayout>
