<?xml version="1.0" encoding="utf-8"?>
<!-- 更新确认弹窗:标题 + 版本说明(Markdown 渲染、左对齐、可滚动)+ 立即更新/稍后 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:padding="@dimen/dp_20">

    <!-- 标题行:gravity=center_vertical —— 标题是 16sp 一行字、关闭键是 40dp 方框,
         不居中两者就会一高一低(用户口径:"关闭按钮和标题没有垂直对齐") -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/note_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="发现新版本"
            android:textColor="@color/text_foreground"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/note_close"
            style="@style/DialogCloseButton"
            app:tint="@color/text_foreground" />
    </LinearLayout>

    <!-- 说明区:高度 0dp + weight=1 = 吃掉标题行与按钮行之外的全部剩余高度。
         这样卡片本身"撑不高":一旦总高被上限约束,说明区自动缩小并自己滚动,
         标题与稍后/立即更新永远留在卡片内(不再靠事后改高度,那受 XPopup 异步定尺寸影响)。 -->
    <ScrollView
        android:id="@+id/note_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/dp_8"
        android:clipToPadding="false"
        android:minHeight="@dimen/dp_80"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:scrollbars="none">

        <TextView
            android:id="@+id/note_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/text_foreground"
            android:textIsSelectable="true"
            android:textSize="14sp" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <!-- 「稍后」是次要动作,走共用样式 BtnSecondary —— 与局域网弹窗的「立即重启应用」同一套:
             描边不填充(= 空心按钮:btn_cancel_bg 描边 + 文字主色)+ 主题圆角 radius_btn,
             换主题时和所有 Btn* 按钮一起变。
             这里原本是手搓的 TextView + 一个描边 selector(旧文件 bg_btn_outline_selector.xml),三处与共用样式不一致:
             圆角走硬编码的 common_corners(不跟主题)、字号 13sp 而右侧是 14sp、
             还要靠 translationY="-1dp" 手动对齐隔壁的 MaterialButton。
             全项目只有这一处用过那个 drawable,已随之删除。 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/note_later"
            style="@style/BtnSecondary"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:focusable="true"
            android:text="稍后" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/note_update"
            style="@style/BtnPrimary"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginLeft="@dimen/dp_10"
            android:layout_weight="1"
            android:focusable="true"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="立即更新" />
    </LinearLayout>
</LinearLayout>
