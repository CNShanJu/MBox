<?xml version="1.0" encoding="utf-8"?>
<!-- 注意外边距的归属:根布局**不留边** —— 底部"长按多选操作栏"要贴底整条,与本地视频页那条逐像素同款
     (整块留边会让操作栏变成一条四边留白的方形浮块,和本地视频页那条对不上)。
     10dp 的页面边距改由卡片自己带(layout_margin="10dp"),底部信息条另给左右/下边距。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- ============ 下载相关 box:独立圆角卡片(悬浮面 bg_surface,与底栏/「我的」页同一个面),
         内容超出内部滚动 ============ -->
    <LinearLayout
        android:id="@+id/ll_download_box"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="10dp"
        android:layout_weight="1"
        android:background="@drawable/bg_large_round_float"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">

        <!-- 剧集展示插槽:聚合组件 / 详情组件 二选一换入 -->
        <FrameLayout
            android:id="@+id/fl_series_slot"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- 聚合组件:剧集网格(收藏页样式),点击进入详情组件,长按圆形多选 -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_aggregate"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="6dp" />

            <!-- 聚合级空态:无任何下载任务/档案时展示 -->
            <include
                android:id="@+id/ll_aggregate_empty"
                layout="@layout/view_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <!-- 详情组件:剧集详情状态页(导航路径 + 正在下载/下载完成 两个 tab) -->
            <LinearLayout
                android:id="@+id/ll_detail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- 路径展示:只展示 片名 · 来源,点按返回聚合根级 -->
                <LinearLayout
                    android:id="@+id/ll_nav"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:foreground="?selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="6dp">

                    <ImageView
                        android:id="@+id/iv_nav_back"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:src="@drawable/ic_seek_left"
                        app:tint="@color/text_foreground" />

                    <TextView
                        android:id="@+id/tv_nav_path"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/text_foreground"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="2dp"
                    android:background="@color/gray_darker_press_alpha" />

                <!-- Tab 行:正在下载 / 下载完成 -->
                <LinearLayout
                    android:id="@+id/ll_tabs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_tab_downloading"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:paddingVertical="10dp"
                        android:text="正在下载"
                        android:textColor="@color/colorPrimary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_tab_done"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:paddingVertical="10dp"
                        android:text="下载完成"
                        android:textColor="@color/text_sub_foreground"
                        android:textSize="16sp" />
                </LinearLayout>

                <!-- 两个 Tab 共用同一内容区域；切换时旧页滑出、新页滑入。 -->
                <FrameLayout
                    android:id="@+id/tab_page_container"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipChildren="true">

                <!-- 正在下载:该剧任务列表 -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_downloading"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingBottom="6dp"
                    android:clipToPadding="false"
                    />

                <!-- 下载中空态:该剧无下载中/排队任务 -->
                <include
                    android:id="@+id/ll_downloading_empty"
                    layout="@layout/view_empty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

                <!-- 下载完成:该剧文件列表 -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_done"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" 
                    android:paddingBottom="6dp"
                    android:clipToPadding="false"
                    />

                <!-- 下载完成空态:该剧无已完成文件 -->
                <include
                    android:id="@+id/ll_done_empty"
                    layout="@layout/view_empty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- 控件 box:长按多选时的"批量动作"行(仅"正在下载"tab 多选时显示,吸底于下载 box 底部)。
             注意:全选/删除/取消全选**不在这里** —— 那三个键走公共组件 select_action_bar,
             显示时占用底部"可用空间·下载配置"条的位置(见 DownloadFragment.updateToolbar)。 -->
        <LinearLayout
            android:id="@+id/ll_toolbar_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_pause_all"
                style="@style/BtnSecondary"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginRight="8dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:paddingHorizontal="4dp"
                android:text="全部暂停" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_start_all"
                style="@style/BtnPrimary"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:paddingHorizontal="4dp"
                android:text="全部开始" />
        </LinearLayout>
    </LinearLayout>

    <!-- ============ 显示内存和其他信息 box:无背景色,文字居中(与下面的操作栏同一格,互斥显示) ============ -->
    <LinearLayout
        android:id="@+id/ll_storage_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginBottom="10dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingVertical="4dp">

        <TextView
            android:id="@+id/tv_storage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/text_sub_foreground"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- ============ 长按多选操作栏(公共组件):与上面的"可用空间·下载配置"条**同一格** ——
         多选时把那条临时顶掉(用户口径),两者互斥显示,见 DownloadFragment.updateToolbar。
         贴底整条、不留边、背景走主题悬浮面:与本地视频页那条是同一个组件、同一观感 ============ -->
    <com.github.tvbox.osc.ui.kit.SelectActionBar
        android:id="@+id/select_action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

</LinearLayout>
