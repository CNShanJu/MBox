<?xml version="1.0" encoding="utf-8"?>
<!-- 联想弹窗:本类直接继承 XPopup 的 PartShadowPopupView,面板底由这份布局自己给
     —— 原来写的是纯色 @color/bg_float(方形无圆角),而里面的 chip 是 8dp 圆角,
     用户口径"联想弹窗里的 chip 和弹窗面板圆角不一致"就是这个。
     面板与 chip 必须是**同一档圆角**:这里用 bg_bubble(浮层底色 bg_float + 小件档 8dp),
     与同屏的历史/热词 chip 完全同款。
     不要改回弹窗/抽屉**面板**档(bg_dialog = radius_dialog,2026-09-27 起弹窗面板底只有这一份;
     原来还有一份挂 radius_background 的 bg_large_round_popup,已删),
     放在这一条只装 chip 的浮层上会比里面的 chip 明显更圆(上一版就是这么写的,注释还写着"统一 8dp")。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg_bubble"
    >

    <!-- 自研流式容器(ui/kit/FlowTagLayout),不再用第三方 flowlayout-lib:
         那条库的行高漏算子视图上下外边距,标签下半截(含圆角)会被裁 -->
    <com.github.tvbox.osc.ui.kit.FlowTagLayout
        android:id="@+id/fl_suggest"
        app:max_select="1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp" />
</LinearLayout>