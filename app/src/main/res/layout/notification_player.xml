<?xml version="1.0" encoding="utf-8"?>
<!-- 后台播放通知(展开态):两列 —— 左列＝剧名 / 集数 / 控制行,右列＝应用图标(单独一列、垂直居中)。
     两条文字都必须"单行 + 省略号 + 宽度受约束":剧名很长时以前会自己换行,把下面的
     上一集/播放暂停/下一集整行顶出通知高度,控件就点不到了(报过"暂停控件被挤出去")。
     高度交给内容(不再写死 130dp):大字体下也只会变高,不会把控制行挤出可视区 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <!-- 左列:文字 + 控制行(占满图标列之外的宽度,标题据此省略) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="剧名"
            android:textColor="@color/text_foreground"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- 第二行:正在播放的集数 -->
        <TextView
            android:id="@+id/tv_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="SubtitleSubtitleSubtitleSubtitleSubtitleSubtitle" />

        <!-- 控制行:上一集 / 播放暂停 / 下一集 / 关闭(固定排在文字下面,与剧名长短无关) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_previous"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="4dp"
                android:src="@drawable/ic_notify_pre" />

            <ImageView
                android:id="@+id/iv_play_pause"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginHorizontal="20dp"
                android:padding="4dp"
                android:src="@drawable/ic_notify_pause" />

            <ImageView
                android:id="@+id/iv_next"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="4dp"
                android:src="@drawable/ic_notify_next" />

            <ImageView
                android:id="@+id/iv_close"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="20dp"
                android:padding="6dp"
                android:src="@drawable/ic_notify_close" />
        </LinearLayout>
    </LinearLayout>

    <!-- 右列:应用图标,与整块内容垂直居中 -->
    <ImageView
        android:id="@+id/iv_logo"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="12dp"
        android:src="@drawable/app_icon" />

</LinearLayout>
