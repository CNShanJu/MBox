<?xml version="1.0" encoding="utf-8"?>
<!-- 直播设置面板的分组列(画面比例/播放解码/超时换源/偏好设置):与右侧条目列同一套文字口径,
     两列一起对齐播放详情的选集 chip —— 未选中 = 次要灰常规 16sp,选中 = 主题高亮色加粗 17sp,
     **无边框无背景**(色值由 LiveSettingGroupAdapter 每次 bind 设置)。
     同样不挂 shape_live_focus 聚焦底色:只去掉右列的蓝底会让面板左列一块蓝、右列没有,观感割裂。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="10dp"
    android:layout_gravity="center"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/tvSettingGroupName"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_weight="1"
        android:ellipsize="marquee"
        android:gravity="center"
        android:marqueeRepeatLimit="marquee_forever"
        android:singleLine="true"
        android:textColor="@color/text_sub_foreground"
        android:textSize="16sp" />
</LinearLayout>
