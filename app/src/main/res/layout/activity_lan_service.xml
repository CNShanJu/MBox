<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.github.tvbox.osc.ui.kit.AppTitleBar
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="局域网服务"
        app:titleBold="true">

        <ImageView
            android:id="@+id/ivLanHelp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="使用说明"
            android:padding="9dp"
            android:src="@drawable/ic_use_description_24" />
    </com.github.tvbox.osc.ui.kit.AppTitleBar>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_large_round_float"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:id="@+id/llLanServer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="true"
                    android:foreground="?android:selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="允许局域网访问"
                            android:textColor="@color/text_foreground"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="开启后需重启应用才能访问；关闭后立即停止局域网访问。"
                            android:textColor="@color/text_sub_foreground"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <com.github.tvbox.osc.ui.kit.AppSwitch
                        android:id="@+id/switchLanServer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:clickable="false" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvLanState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/text_highlight"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLanRestart"
                    style="@style/BtnPrimary"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_gravity="end"
                    android:layout_marginTop="10dp"
                    android:text="重启应用"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/panelLanAccess"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_large_round_float"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="访问地址与配对码"
                    android:textColor="@color/text_foreground"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvLanLead"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:textColor="@color/text_sub_foreground"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/llLanAddresses"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="配对码"
                    android:textColor="@color/text_sub_foreground"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvLanPairingCode"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:singleLine="true"
                        android:textColor="@color/text_highlight"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnShowLanQr"
                        style="@style/TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:text="二维码"
                        android:textColor="@color/text_highlight"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/btnCopyPairingCode"
                        style="@style/TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:text="复制"
                        android:textColor="@color/text_highlight"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/btnRotatePairingCode"
                        style="@style/TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginStart="6dp"
                        android:contentDescription="更新配对码"
                        android:text="更新"
                        android:textColor="@color/text_highlight"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/panelLanConsole"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_large_round_float"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="MBox 局域网控制台"
                        android:textColor="@color/text_foreground"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnOpenLanConsole"
                        style="@style/TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="查看"
                        android:textColor="@color/text_highlight" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvLanConsoleSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:textColor="@color/text_sub_foreground"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/panelLanImport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_large_round_float"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="局域网配置导入导出"
                    android:textColor="@color/text_foreground"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="导入时连接另一台 MBox 并选择配置；导出时开启本机服务，让对方连接并选择要取走的配置。批量传输使用 ZIP。"
                    android:textColor="@color/text_sub_foreground"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvImportConnection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/text_sub_foreground"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLanImport"
                    style="@style/BtnPrimary"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="12dp"
                    android:text="连接服务器" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLanExport"
                    style="@style/BtnSecondary"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="8dp"
                    android:text="导出给其他设备" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
