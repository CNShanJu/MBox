<?xml version="1.0" encoding="utf-8"?>
<!-- 有进度时将动画、文字、取消键合为一个主题面板;纯动画加载态仍不显示面板底。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/loading_panel"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="20dp">

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottie_loading"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="center_horizontal"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        app:lottie_autoPlay="true"
        app:lottie_speed="1"
        app:lottie_loop="true"
        app:lottie_repeatMode="restart" />

    <LinearLayout
        android:id="@+id/loading_status_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_loading_msg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:breakStrategy="simple"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:minHeight="44dp"
            android:textColor="@color/text_foreground"
            android:textSize="14sp"
            android:visibility="gone"
            tools:text="正在解析订阅源 3/10…"
            tools:visibility="visible" />

        <!-- 仅可取消流程显示,沿用确认弹窗的空心按钮和高度。 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_loading_cancel"
            style="@style/BtnSecondary"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="取消"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>
</LinearLayout>
