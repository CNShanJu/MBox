<?xml version="1.0" encoding="utf-8"?>
<!-- 全局加载框:动画浮在遮罩上；有提示/取消键时，文字放在不透底的主题面板中，
     避免页面列表文字穿透进度信息。面板与动画的间距由 LoadingAnim 配置调整。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingLeft="12dp"
    android:paddingRight="12dp">

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottie_loading"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="center_horizontal"
        android:scaleType="centerCrop"
        app:lottie_autoPlay="true"
        app:lottie_speed="1"
        app:lottie_loop="true"
        app:lottie_repeatMode="restart" />

    <LinearLayout
        android:id="@+id/loading_status_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingTop="12dp"
        android:paddingRight="16dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_loading_msg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxWidth="240dp"
            android:textColor="@color/text_foreground"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="正在识别资源站 3/10" />

    <!-- 可取消流程(导出/导入等长耗时)才显示:默认隐藏,由 LoadingDialog.setOnCancel 打开。
         用全局按钮色板 BtnSecondary(= 空心按钮:btn_plain_text 描边与文字 + radius_btn),
         不写任何色值:空心键始终透明,描边与文字随主题同色;加载框遮罩浓度由 DialogCoordinator 控制。
         高度必须写成定高 33dp(与其它弹窗的取消/确定按钮一致):原来用 wrap_content,MaterialButton 默认
         minHeight=48dp → 这个"取消"比其他页的按钮明显大一圈(订阅导入/导出时看到的就是它) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_loading_cancel"
            style="@style/BtnSecondary"
            android:layout_width="wrap_content"
            android:layout_height="33dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="96dp"
            android:text="取消"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>
</LinearLayout>
