<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/llLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/previewPlayerPlace"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/dp_20"
            android:paddingRight="@dimen/dp_20"
            android:paddingBottom="@dimen/dp_10">
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:clipToPadding="false"
            >

            <LinearLayout
                android:layout_width="match_parent"
                android:orientation="vertical"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="14dp"
                    android:orientation="vertical"
                    android:layout_marginTop="20dp"
                    >

                    <LinearLayout
                        android:id="@+id/ll_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxWidth="300dp"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:text="鬼灭之刃鬼灭之刃鬼灭之刃鬼灭之刃鬼灭之刃鬼灭之刃"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_foreground"
                            />

                        <Space
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="详情 >"
                            android:layout_marginRight="10dp"
                            android:textSize="12dp"
                            android:layout_gravity="center|right"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        >

                            <!-- 来源 chip:文字 + 图标。图标尺寸由 app:drawableIconSize 指定 ——
                                 compound drawable 的显示尺寸恒等于素材固有尺寸(vector 的 android:width/height),
                                 原生没有可调属性;用 ui/kit/SizedIconTextView 补上这个能力(依据见其类注释) -->
                            <com.github.tvbox.osc.ui.kit.SizedIconTextView
                                android:id="@+id/tvSite"
                                android:background="@drawable/bg_large_round_float"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:singleLine="true"
                                tools:text="非凡影视"
                                android:textColor="@color/text_foreground"
                                android:drawableRight="@drawable/ic_change_20"
                                app:drawableIconSize="20dp"
                                android:drawablePadding="4dp"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="6dp"/>

                        <Space
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"/>
                        <ImageView
                            android:id="@+id/iv_private_browsing"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:paddingLeft="10dp"
                            android:src="@drawable/ic_private_browsing"
                            android:visibility="gone"
                            tools:visibility="visible"
                            app:tint="@color/text_foreground" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:gravity="end|center_vertical"
                        android:orientation="horizontal">
                        <com.github.tvbox.osc.ui.kit.SizedIconTextView
                            android:id="@+id/tvCast"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/dp_40"
                            android:drawableRight="@drawable/ic_cast_18"
                            app:drawableIconSize="18dp"
                            android:drawablePadding="6dp"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingHorizontal="10dp"
                            android:text="投屏"
                            android:textColor="@color/text_foreground" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="14dp"
                            android:background="@color/gray_darker"
                            android:layout_marginHorizontal="6dp"/>
                        <com.github.tvbox.osc.ui.kit.SizedIconTextView
                            android:id="@+id/tvCollect"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/dp_40"
                            android:drawableRight="@drawable/ic_colloct_18"
                            app:drawableIconSize="18dp"
                            android:drawablePadding="6dp"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingHorizontal="10dp"
                            android:text="收藏"
                            android:textColor="@color/text_foreground" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="14dp"
                            android:background="@color/gray_darker"
                            android:layout_marginHorizontal="6dp"/>
                        <com.github.tvbox.osc.ui.kit.SizedIconTextView style="@style/TextButton"
                            android:id="@+id/tvDownload"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/dp_40"
                            android:drawableRight="@drawable/ic_download_18"
                            app:drawableIconSize="18dp"
                            android:drawablePadding="6dp"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingHorizontal="10dp"
                            android:text="下载"
                            android:textColor="@color/text_foreground" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/bg_gray"
                        android:layout_marginVertical="4dp"/>
                </LinearLayout>


                <LinearLayout
                    android:id="@+id/parse_root"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="解析"
                        android:textColor="@color/text_foreground"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginLeft="14dp"
                        android:layout_marginTop="8dp"
                        android:layout_centerVertical="true"
                        />
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_parse"
                        android:layout_marginHorizontal="10dp"
                        android:layout_marginVertical="4dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        android:orientation="horizontal"
                        tools:listitem="@layout/item_select_flag" 
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:clipToPadding="false"
                        />
                </LinearLayout>
                <RelativeLayout
                    android:id="@+id/rlLineHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="14dp"
                    android:layout_marginTop="14dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="线路"
                        android:textColor="@color/text_foreground"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_centerVertical="true"
                        />
                    <!-- 快捷换线:文字 + 图标(图标尺寸见 app:drawableIconSize,统一走 SizedIconTextView) -->
                    <com.github.tvbox.osc.ui.kit.SizedIconTextView
                        android:id="@+id/tvChangeLine"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="快捷换线"
                        android:drawableRight="@drawable/ic_change_20"
                        app:drawableIconSize="18dp"
                        android:textColor="@color/text_foreground"
                        android:drawablePadding="4dp"
                        android:paddingVertical="6dp"
                        android:paddingLeft="20dp"
                        android:layout_alignParentRight="true"
                        />
                </RelativeLayout>
                <!--        线路列表-->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/mGridViewFlag"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:layout_marginVertical="4dp"
                    tools:listitem="@layout/item_select_flag"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    android:orientation="horizontal"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:clipToPadding="false"
                    />

                <LinearLayout
                    android:id="@+id/llSeriesHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="14dp"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    >
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="选集"
                        android:textColor="@color/text_foreground"
                        android:textSize="16sp"
                        android:layout_centerVertical="true"
                        android:textStyle="bold"
                        />

                    <Space
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"/>
                    <com.github.tvbox.osc.ui.kit.SizedIconTextView
                        android:id="@+id/tvSort"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="倒序"
                        android:drawableRight="@drawable/ic_sort_18"
                        app:drawableIconSize="18dp"
                        android:textColor="@color/text_foreground"
                        android:drawablePadding="4dp"
                        android:paddingVertical="6dp"
                        />

                    <View
                        android:id="@+id/line10"
                        android:layout_width="1dp"
                        android:layout_height="14dp"
                        android:layout_marginHorizontal="10dp"
                        android:background="@color/gray_darker" />
                    <com.github.tvbox.osc.ui.kit.SizedIconTextView
                        android:id="@+id/tv_all_series"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="全部"
                        android:drawableRight="@drawable/ic_expand_all_18"
                        app:drawableIconSize="18dp"
                        android:textColor="@color/text_foreground"
                        android:drawablePadding="4dp"
                        android:paddingVertical="6dp"
                        />
                </LinearLayout>
                <!--        集数列表-->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/mGridView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:layout_marginVertical="16dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    app:tv_horizontalSpacingWithMargins="@dimen/dp_10"
                    app:tv_selectedItemIsCentered="true"
                    app:tv_verticalSpacingWithMargins="@dimen/dp_10"
                    tools:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:orientation="horizontal"
                    tools:listitem="@layout/item_series"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    />
            </LinearLayout>
        </ScrollView>

    </LinearLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/previewPlayer"
        android:layout_width="match_parent"
        android:layout_height="250dp" />

    <!-- 空态:无剧集可播时**整页只显示它**(llLayout 整块隐藏,见 DetailActivity);
         放在页面根层(不再塞在 ScrollView 里)才能在整屏居中;图标在上、文字在下换行排列,
         样式与全 App 统一空态(view_empty)一致 -->
    <LinearLayout
        android:id="@+id/mEmptyPlaylist"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="gone">

        <!-- 负外边距抵消 ic_empty 的透明留白(128dp 框里顶 46dp、底 33dp;原图底部的灰色投影椭圆
             已从矢量移除,底边由 1238 抬到 1190,底留白因此由 29dp 变 33dp,这里同步补 4dp),
             让布局盒子≈图案可见范围、与下方文字间距和 view_empty 空态保持一致 -->
        <ImageView
            android:layout_width="@dimen/dp_128"
            android:layout_height="@dimen/dp_128"
            android:layout_marginTop="-46dp"
            android:layout_marginBottom="-24dp"
            android:src="@drawable/ic_empty" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="暂无播放数据"
            android:textColor="@color/text_sub_foreground"
            android:textSize="14sp" />
    </LinearLayout>

</FrameLayout>
