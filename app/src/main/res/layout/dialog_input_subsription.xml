<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingHorizontal="30dp"
    android:background="@drawable/bg_large_round_popup"
    android:orientation="vertical"
    android:paddingVertical="20dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tv_title"
            android:text="添加订阅"
            android:textColor="@color/text_foreground"
            android:layout_width="wrap_content"
            android:textSize="16sp"
            android:layout_height="wrap_content"/>

        <com.github.tvbox.osc.ui.kit.SizedIconTextView
            android:id="@+id/tv_local"
            android:text="本地导入"
            android:textColor="@color/text_foreground"
            android:layout_width="wrap_content"
            android:textSize="12sp"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/tv_json"
            android:drawableLeft="@drawable/ic_import_file_16"
            app:drawableIconSize="16dp"
            android:drawableTint="@color/text_foreground"
            android:drawablePadding="4dp"/>

        <com.github.tvbox.osc.ui.kit.SizedIconTextView
            android:id="@+id/tv_json"
            android:text="JSON导入"
            android:textColor="@color/text_foreground"
            android:layout_width="wrap_content"
            android:textSize="12sp"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:drawableLeft="@drawable/ic_import_json_16"
            app:drawableIconSize="16dp"
            android:drawableTint="@color/text_foreground"
            android:drawablePadding="4dp"/>
    </RelativeLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_marginTop="10dp"
        android:layout_width="match_parent"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
        android:layout_height="wrap_content"
        android:textColorHint="@color/text_sub_foreground">

        <EditText
            android:id="@+id/et_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:layout_marginTop="10dp"
            android:hint="自定义订阅名"
            android:inputType="textUri"
            android:textColor="@color/text_foreground"
            android:textSize="14sp"
            android:maxLength="10"
            android:singleLine="true"/>

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColorHint="@color/text_sub_foreground">

        <EditText
            android:id="@+id/et_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:layout_marginTop="10dp"
            android:hint="地址 例: https://...(配置 / 采集接口)"
            android:inputType="textUri"
            android:textColor="@color/text_foreground"
            android:textSize="14sp"/>

    </com.google.android.material.textfield.TextInputLayout>

    <!-- 支持范围说明:原来这里只有"地址 例: https://...",用户不知道能填什么、
         也不知道"资源站采集接口地址"可以直接贴进来(会自动嗅探)——把能解析的形态写清楚 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:lineSpacingExtra="2dp"
        android:text="可填:站源配置(JSON)、订阅清单(含多条)、多线路、多仓(填后弹窗选仓)、资源站采集接口地址(自动嗅探生成配置)。\n不是订阅配置时会自动按站点嗅探一次;实在识别不了(书源、频道列表等)会提示。\n也可用上方「本地导入」选文件,或用「JSON导入」粘贴内容。"
        android:textColor="@color/text_sub_foreground"
        android:textSize="12sp"/>

    <CheckBox
        android:id="@+id/cb_check"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="使用此订阅"
        android:checked="false"
        android:layout_gravity="end"
        android:textColor="@color/text_foreground"
        />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_height="33dp"
            android:layout_marginRight="20dp"
            android:text="取 消"
            style="@style/BtnSecondary"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_confirm"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_height="33dp"
            style="@style/BtnPrimary"
            android:text="添 加"/>

    </LinearLayout>
</LinearLayout>