<?xml version="1.0" encoding="utf-8"?>
<!-- 更新下载信息弹窗:版本 + 进度 + 暂停/继续 + 不再更新 + 安装(下载完成后) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:padding="@dimen/dp_20">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/update_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:singleLine="true"
            android:text="APP更新下载"
            android:textColor="@color/text_foreground"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_close_24"
            app:tint="@color/text_foreground" />
    </LinearLayout>

    <TextView
        android:id="@+id/update_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:textColor="@color/text_foreground"
        android:textSize="14sp"
        tools:text="发现新版本 v3.2.0" />

    <ProgressBar
        android:id="@+id/update_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_marginTop="@dimen/dp_20"
        android:max="100"
        android:progressDrawable="@drawable/bg_update_progress" />

    <TextView
        android:id="@+id/update_progress_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:textColor="@color/text_foreground"
        android:textSize="13sp"
        tools:text="下载中 40% (12.3MB/30.5MB)" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_20"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_pause_resume"
            style="@style/BtnSecondary"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:focusable="true"
            android:text="暂停" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_dismiss"
            style="@style/BtnSecondary"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginLeft="@dimen/dp_10"
            android:layout_weight="1"
            android:focusable="true"
            android:text="放弃更新" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_install"
            style="@style/BtnPrimary"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginLeft="@dimen/dp_10"
            android:layout_weight="1"
            android:focusable="true"
            android:text="安装"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
