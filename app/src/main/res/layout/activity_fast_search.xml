<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:zhy="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingTop="40dp">


    <LinearLayout
        android:id="@+id/llSearchBar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:layout_marginBottom="10dp"
        >

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/bar_arrows_left_black"/>
        <com.github.tvbox.osc.ui.kit.ClearEditText
                android:id="@+id/et_search"
                android:layout_width="wrap_content"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:hint="搜索"
                android:textSize="16sp"
                android:layout_marginHorizontal="10dp"
                android:background="@null"
                android:imeOptions="actionSearch"
                android:inputType="text"
        />

        <ImageView
            android:id="@+id/iv_filter"
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:padding="1dp"
            android:src="@drawable/ic_filter_list"
            app:tint="@color/text_foreground"
            android:layout_marginRight="4dp"/>

        <View
            android:layout_width="1dp"
            android:layout_height="16sp"
            android:background="@color/text_foreground"/>

        <ImageView
                android:id="@+id/iv_search"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_search"
                app:tint="@color/text_foreground"
                android:layout_marginLeft="5dp"
        />

        <View
            android:layout_width="1dp"
            android:layout_height="16sp"
            android:layout_marginLeft="4dp"
            android:background="@color/text_foreground"/>

        <ImageView
                android:id="@+id/iv_more"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_more_24"
                android:padding="2dp"
                app:tint="@color/text_foreground"
                android:layout_marginLeft="1dp"
        />

    </LinearLayout>
    <LinearLayout
        android:id="@+id/llSearchSuggest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp"
        >

        <LinearLayout
            android:id="@+id/ll_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible"
            android:layout_marginBottom="30dp"
            >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                >

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="历史搜索"
                    android:textSize="15sp"
                    />

                <ImageView
                    android:id="@+id/iv_clear_history"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_clear"
                    app:tint="@color/gray_darker"
                    android:paddingTop="6dp"
                    android:paddingBottom="4dp"
                    />
            </LinearLayout>

            <com.zhy.view.flowlayout.TagFlowLayout
                android:id="@+id/fl_history"
                zhy:max_select="1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
            </com.zhy.view.flowlayout.TagFlowLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="热门搜索"
            android:textSize="15sp"
            android:textAlignment="center"/>

        <com.zhy.view.flowlayout.TagFlowLayout
            android:id="@+id/fl_hot"
            zhy:max_select="1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
        </com.zhy.view.flowlayout.TagFlowLayout>

    </LinearLayout>

    <!-- 搜索结果区:结果列表(满屏宽)为底层,来源列表(固定 140dp)同容器收纳在屏左外;
         内容区向右横滑把来源列表覆盖式滑出、左滑收回,松手自动吸附 -->
    <com.github.tvbox.osc.ui.widget.HorizontalSlidePagesLayout
        android:id="@+id/llSearchResult"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        tools:visibility="visible">

        <!-- 结果区:顶部下拉=拉伸回弹+刷新转圈混合(重新搜索);到底=悬浮"到底了"+上推回弹 -->
        <com.github.tvbox.osc.ui.kit.RubberBandSwipeRefreshLayout
            android:id="@+id/llLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingLeft="10dp"
            android:paddingRight="10dp">

            <com.github.tvbox.osc.ui.kit.RubberBandRecyclerView
                android:id="@+id/mGridView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:rubber_top_enabled="false"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingBottom="70dp"
                android:visibility="invisible"
                app:tv_horizontalSpacingWithMargins="@dimen/dp_5"
                app:tv_selectedItemIsCentered="true"
                app:tv_verticalSpacingWithMargins="@dimen/dp_12" />

            <com.github.tvbox.osc.ui.kit.RubberBandRecyclerView
                android:id="@+id/mGridViewFilter"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:rubber_top_enabled="false"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingBottom="70dp"
                android:visibility="invisible"
                app:tv_horizontalSpacingWithMargins="@dimen/dp_5"
                app:tv_selectedItemIsCentered="true"
                app:tv_verticalSpacingWithMargins="@dimen/dp_12" />

            <!-- "到底了"悬浮提示:与首页/分类一致,仅"确实到最底且内容超一屏"时显示 -->
            <include
                android:id="@+id/end_tip"
                layout="@layout/item_view_end_tip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="20dp"
                android:visibility="gone" />
        </com.github.tvbox.osc.ui.kit.RubberBandSwipeRefreshLayout>

        <!-- 来源列表(左页):固定 140dp,平时收在屏左外;内容区向右横滑整盒右移,松手吸附。
             无独立底色,与结果列表/页面背景一致,选中高亮由 DslTabLayout 自身绘制;
             选中底色用 bg_small_round_float(= 悬浮面 bg_float,与底部导航栏同色同透明度 92%),
             不要用不透明的 bg_small_round_gray,否则与底栏深浅/通透度不一致 -->
        <LinearLayout
            android:id="@+id/llWord"
            android:layout_width="140dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingLeft="10dp">

            <com.angcyo.tablayout.DslTabLayout
                android:id="@+id/tab_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:tab_draw_highlight="true"
                app:tab_indicator_drawable="@drawable/bg_small_round_float"
                app:tab_orientation="VERTICAL"
                app:tab_select_color="@color/colorPrimary"
                app:tab_deselect_color="@color/text_sub_foreground">

            </com.angcyo.tablayout.DslTabLayout>
        </LinearLayout>
    </com.github.tvbox.osc.ui.widget.HorizontalSlidePagesLayout>
</LinearLayout>