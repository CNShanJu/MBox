<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:paddingTop="40dp">


    <LinearLayout
        android:id="@+id/llSearchBar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:layout_marginBottom="10dp"
        >

        <!-- 返回:与其它二级页同一个箭头(播放器的快退 chevron),颜色走主题 ——
             原来直接用 TitleBar 库自带的 bar_arrows_left_black(写死黑),暗色主题下几乎看不见。
             24dp 的框 + 6dp 内边距 = 图标只画 12dp(与其他页同样"缩小一半"),点击区仍是 24dp -->
        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:padding="6dp"
            android:src="@drawable/ic_seek_left"
            app:tint="@color/text_foreground"/>
        <!-- 输入框:文字/占位色必须显式写主题色 —— 不写就走主题里的 ?attr/textColorPrimary(编译期固定),
             自定义主题下这里不会跟着变(用户口径:"搜索页面的输入框里文字没变") -->
        <com.github.tvbox.osc.ui.kit.ClearEditText
                android:id="@+id/et_search"
                android:layout_width="wrap_content"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:hint="搜索"
                android:textColor="@color/text_foreground"
                android:textColorHint="@color/text_hint"
                android:textSize="16sp"
                android:layout_marginHorizontal="10dp"
                android:background="@null"
                android:imeOptions="actionSearch"
                android:inputType="text"
        />

        <ImageView
            android:id="@+id/iv_filter"
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:padding="1dp"
            android:src="@drawable/ic_filter_list"
            app:tint="@color/text_foreground"
            android:layout_marginRight="4dp"/>

        <View
            android:layout_width="1dp"
            android:layout_height="16sp"
            android:background="@color/text_foreground"/>

        <ImageView
                android:id="@+id/iv_search"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_search"
                app:tint="@color/text_foreground"
                android:layout_marginLeft="5dp"
        />

        <View
            android:layout_width="1dp"
            android:layout_height="16sp"
            android:layout_marginLeft="4dp"
            android:background="@color/text_foreground"/>

        <ImageView
                android:id="@+id/iv_more"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_more_24"
                android:padding="2dp"
                app:tint="@color/text_foreground"
                android:layout_marginLeft="1dp"
        />

    </LinearLayout>
    <!-- 横屏时榜单和历史搜索仍可完整滚动；两块内容按同一宽度居中。 -->
    <ScrollView
        android:id="@+id/scroll_search_suggest"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:scrollbars="none">
    <LinearLayout
        android:id="@+id/llSearchSuggest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        >

        <!-- 相关搜索:输入即出(爱奇艺联想接口 suggest.video.iqiyi.com/?if=mobile&key=),
             参考 NewBox 的做法 —— **内联 chip 两列**,不再弹浮层(XPopup 那条已下线)。
             没输入时整块收起,页面回到"最近热搜 + 搜索历史"。
             小标题统一口径(用户口径):**文字主色、不带透明度、加粗**。 -->
        <TextView
            android:id="@+id/tv_suggest_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="相关搜索"
            android:textColor="@color/text_foreground"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.github.tvbox.osc.ui.kit.FlowTagLayout
            android:id="@+id/fl_suggest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- 最近热搜始终两列；与历史搜索共用宽度并居中，每列自上而下连续排名。 -->
        <LinearLayout
            android:id="@+id/ll_hot_rank"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:clipToPadding="false"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tv_hot_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="最近热搜"
                android:textColor="@color/text_foreground"
                android:textSize="15sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_hot_rank"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_large_round_float"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:paddingVertical="6dp"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="2" />
        </LinearLayout>

        <!-- 历史搜索:与热搜块同宽居中,并与上方热搜卡留出间距(原来贴着卡片,用户口径"距离太近了");
             清除键挪到标题行**最右**(标题左、图标右,中间 Space 撑开) -->
        <LinearLayout
            android:id="@+id/ll_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="30dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                >

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="历史搜索"
                    android:textColor="@color/text_foreground"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    />

                <!-- 撑开:清空键一律贴标题行最右(原来紧跟标题文字,看着像标题的一部分) -->
                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/iv_clear_history"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_clear"
                    app:tint="@color/text_danger"
                    android:paddingTop="6dp"
                    android:paddingBottom="4dp"
                    />
            </LinearLayout>

            <!-- 自研流式容器(ui/kit/FlowTagLayout):原来用第三方 flowlayout-lib,它的行高漏算子视图
                 的上下外边距,最后一行会把标签下半截(含圆角)裁掉。自研版把行高算全,不再需要
                 clipChildren=false 这类补丁。标签间距 = item_search_word_hot 自己的 layout_margin。
                 **不要写 app:max_select**:那些标签是"点一下就搜"的点击件,不是可选件 ——
                 原来写了 1,点一下就被置 selected,chip 的底 selector_widget_btn 恰好有
                 "选中=实心填充"状态,于是点过的历史词变成一块选中色(用户口径"点击之后会给选中色背景")。 -->
            <com.github.tvbox.osc.ui.kit.FlowTagLayout
                android:id="@+id/fl_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" />
        </LinearLayout>

    </LinearLayout>
    </ScrollView>

    <!-- 搜索结果区:结果列表(满屏宽)为底层,来源列表(固定 140dp)同容器收纳在屏左外;
         内容区向右横滑把来源列表覆盖式滑出、左滑收回,松手自动吸附 -->
    <com.github.tvbox.osc.ui.widget.HorizontalSlidePagesLayout
        android:id="@+id/llSearchResult"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        tools:visibility="visible">

        <!-- 结果区:顶部下拉=拉伸回弹+刷新转圈混合(重新搜索);到底=悬浮"到底了"+上推回弹 -->
        <com.github.tvbox.osc.ui.kit.RubberBandSwipeRefreshLayout
            android:id="@+id/llLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingLeft="10dp"
            android:paddingRight="10dp">

            <com.github.tvbox.osc.ui.kit.RubberBandRecyclerView
                android:id="@+id/mGridView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:rubber_top_enabled="false"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingBottom="70dp"
                android:visibility="invisible"
                app:tv_horizontalSpacingWithMargins="@dimen/dp_5"
                app:tv_selectedItemIsCentered="true"
                app:tv_verticalSpacingWithMargins="@dimen/dp_12" />

            <com.github.tvbox.osc.ui.kit.RubberBandRecyclerView
                android:id="@+id/mGridViewFilter"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:rubber_top_enabled="false"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingBottom="70dp"
                android:visibility="invisible"
                app:tv_horizontalSpacingWithMargins="@dimen/dp_5"
                app:tv_selectedItemIsCentered="true"
                app:tv_verticalSpacingWithMargins="@dimen/dp_12" />

            <!-- "到底了"悬浮提示:与首页/分类一致,仅"确实到最底且内容超一屏"时显示 -->
            <include
                android:id="@+id/end_tip"
                layout="@layout/item_view_end_tip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="20dp"
                android:visibility="gone" />
        </com.github.tvbox.osc.ui.kit.RubberBandSwipeRefreshLayout>

        <!-- 来源列表(左页):固定 140dp,平时收在屏左外;内容区向右横滑整盒右移,松手吸附。
             无独立底色,与结果列表/页面背景一致,选中高亮由 DslTabLayout 自身绘制;
             选中底色用 bg_small_round_float(= 悬浮面 bg_surface,与底部导航栏同色同透明度 92%),
             不要用不透明的 bg_small_round_gray,否则与底栏深浅/通透度不一致 -->
        <LinearLayout
            android:id="@+id/llWord"
            android:layout_width="140dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingLeft="10dp">

            <com.angcyo.tablayout.DslTabLayout
                android:id="@+id/tab_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:tab_draw_highlight="true"
                app:tab_indicator_drawable="@drawable/bg_small_round_float"
                app:tab_orientation="VERTICAL"
                app:tab_select_color="@color/colorPrimary"
                app:tab_deselect_color="@color/text_sub_foreground">

            </com.angcyo.tablayout.DslTabLayout>
        </LinearLayout>
    </com.github.tvbox.osc.ui.widget.HorizontalSlidePagesLayout>
</LinearLayout>
