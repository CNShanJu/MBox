<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_playing_control">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:clipToPadding="true"
        android:paddingTop="6dp"
        android:paddingBottom="16dp"
        android:paddingHorizontal="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="倍速"
                android:textColor="@color/text_foreground"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"
                android:layout_marginTop="16dp"/>

            <HorizontalScrollView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scrollbars="none">
                <LinearLayout
                    android:id="@+id/container_speed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView style="@style/WidgetBtn"
                        android:id="@+id/speed0"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:gravity="center"
                        android:singleLine="true"
                        android:paddingVertical="4dp"
                        android:paddingHorizontal="10dp"
                        android:text="x0.5" />

                    <TextView style="@style/WidgetBtn"
                        android:id="@+id/speed1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:gravity="center"
                        android:singleLine="true"
                        android:paddingVertical="4dp"
                        android:paddingHorizontal="10dp"
                        android:text="x1.0" />

                    <TextView style="@style/WidgetBtn"
                        android:id="@+id/speed1a"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:gravity="center"
                        android:singleLine="true"
                        android:paddingVertical="4dp"
                        android:paddingHorizontal="10dp"
                        android:text="x1.25" />

                    <TextView style="@style/WidgetBtn"
                        android:id="@+id/speed2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:gravity="center"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:singleLine="true"
                        android:text="x1.5"
                         />

                    <TextView style="@style/WidgetBtn"
                        android:id="@+id/speed3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:gravity="center"
                        android:singleLine="true"
                        android:paddingVertical="4dp"
                        android:paddingHorizontal="10dp"
                        android:text="x2.0" />
                    <TextView style="@style/WidgetBtn"
                        android:id="@+id/speed4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:gravity="center"
                        android:singleLine="true"
                        android:paddingVertical="4dp"
                        android:paddingHorizontal="10dp"
                        android:text="x2.5" />
                    <TextView style="@style/WidgetBtn"
                        android:id="@+id/speed5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:gravity="center"
                        android:singleLine="true"
                        android:paddingVertical="4dp"
                        android:paddingHorizontal="10dp"
                        android:text="x3.0" />
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="10dp"
                android:text="缩放"
                android:textColor="@color/text_foreground"
                android:textSize="16sp"
                android:textStyle="bold"
                />

            <!-- 图标尺寸由 app:drawableIconSize 指定:compound drawable 恒按素材固有尺寸绘制,
                 原生无属性可调,故走 ui/kit/SizedIconTextView(依据见其类注释) -->
            <com.github.tvbox.osc.ui.kit.SizedIconTextView style="@style/WidgetBtn"
                android:id="@+id/scale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:singleLine="true"
                android:paddingVertical="4dp"
                android:paddingHorizontal="10dp"
                android:drawableRight="@drawable/ic_change_20"
                app:drawableTint="@color/text_foreground"
                app:drawableIconSize="20dp"
                android:drawablePadding="8dp"
                tools:text="16:9"
                />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="10dp"
                android:text="跳过片头/片尾"
                android:textColor="@color/text_foreground"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/decrease_start"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_seek_left"
                    app:tint="@color/text_foreground"
                    />
                <TextView
                    android:id="@+id/play_time_start"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:gravity="center"
                    android:singleLine="true"
                    android:textColor="@color/text_foreground"
                    android:paddingVertical="4dp"
                    android:paddingHorizontal="10dp"
                    tools:text="片头" />
                <ImageView
                    android:id="@+id/increase_start"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_seek_right"
                    app:tint="@color/text_foreground"
                    />

                <ImageView
                    android:id="@+id/decrease_end"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_seek_left"
                    app:tint="@color/text_foreground"
                    android:layout_marginStart="10dp"
                    />
                <TextView
                    android:id="@+id/play_time_end"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:gravity="center"
                    android:singleLine="true"
                    android:textColor="@color/text_foreground"
                    android:paddingVertical="4dp"
                    android:paddingHorizontal="10dp"
                    tools:text="片尾" />
                <ImageView
                    android:id="@+id/increase_end"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_seek_right"
                    app:tint="@color/text_foreground"
                    />

                <TextView style="@style/WidgetBtn"
                    android:id="@+id/start_end_reset"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:gravity="center"
                    android:singleLine="true"
                    android:paddingVertical="4dp"
                    android:paddingHorizontal="10dp"
                    android:layout_marginStart="10dp"
                    android:text="重置" />
            </LinearLayout>
            </HorizontalScrollView>


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="10dp"
                android:text="播放器"
                android:textColor="@color/text_foreground"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- 图标尺寸由 app:drawableIconSize 统一指定(见 ui/kit/SizedIconTextView) -->
                <com.github.tvbox.osc.ui.kit.SizedIconTextView style="@style/WidgetBtn"
                    android:id="@+id/player"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:gravity="center"
                    android:singleLine="true"
                    android:paddingVertical="4dp"
                    android:paddingHorizontal="10dp"
                    android:drawableRight="@drawable/ic_change_20"
                    app:drawableTint="@color/text_foreground"
                    app:drawableIconSize="20dp"
                    android:drawablePadding="8dp"
                    tools:text="EXO" />

                <com.github.tvbox.osc.ui.kit.SizedIconTextView style="@style/WidgetBtn"
                    android:id="@+id/decode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:gravity="center"
                    android:singleLine="true"
                    android:paddingVertical="4dp"
                    android:paddingHorizontal="10dp"
                    android:drawableRight="@drawable/ic_change_20"
                    app:drawableTint="@color/text_foreground"
                    app:drawableIconSize="20dp"
                    android:drawablePadding="8dp"
                    tools:text="硬解" />


            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="10dp"
                android:text="其他"
                android:textColor="@color/text_foreground"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">
                <TextView style="@style/WidgetBtn"
                    android:id="@+id/landscape_portrait"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:gravity="center"
                    android:singleLine="true"
                    android:paddingVertical="4dp"
                    android:paddingHorizontal="10dp"
                    android:text="横竖屏"
                    android:visibility="gone"
                    tools:visibility="visible"
                    />

                <TextView style="@style/WidgetBtn"
                    android:id="@+id/subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:gravity="center"
                    android:singleLine="true"
                    android:paddingVertical="4dp"
                    android:paddingHorizontal="10dp"
                    android:text="字幕" />

                <TextView style="@style/WidgetBtn"
                    android:id="@+id/voice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:gravity="center"
                    android:singleLine="true"
                    android:paddingVertical="4dp"
                    android:paddingHorizontal="10dp"
                    android:text="音轨" />


                <TextView style="@style/WidgetBtn"
                    android:id="@+id/replay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:gravity="center"
                    android:singleLine="true"
                    android:paddingVertical="4dp"
                    android:paddingHorizontal="10dp"
                    android:text="重播" />

                <TextView style="@style/WidgetBtn"
                    android:id="@+id/refresh"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:gravity="center"
                    android:singleLine="true"
                    android:paddingVertical="4dp"
                    android:paddingHorizontal="10dp"
                    android:text="刷新" />

            </LinearLayout>
            </HorizontalScrollView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>