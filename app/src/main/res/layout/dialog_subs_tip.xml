<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="20dp"
    android:paddingBottom="20dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="订阅提示"
                android:textColor="@color/text_foreground"
                android:textStyle="bold"
                android:textSize="16sp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="6dp"
                android:text="@string/subs_use_tip"
                android:textColor="@color/text_foreground"
                android:layout_marginTop="10dp"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="免责说明"
                android:textColor="@color/text_foreground"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginTop="20dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="6dp"
                android:text="@string/subs_tip"
                android:textColor="@color/text_foreground"
                android:layout_marginTop="10dp"
                />
        </LinearLayout>
    </ScrollView>

    <!-- 按钮完全走主题按钮样式 BtnPrimary(主色填充 / 文字 btn_confirm_text / 圆角 radius_btn 都来自主题):
         不要再写 android:textColor(以前写死 text_foreground = 页面正文色,在深色主按钮上几乎看不见,等于绕开了主题按钮色板),
         也不要再单独覆盖 cornerRadius —— 圆角由 btn 主题键统一管 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_cancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        style="@style/BtnPrimary"
        android:text="知道了"/>
</LinearLayout>
