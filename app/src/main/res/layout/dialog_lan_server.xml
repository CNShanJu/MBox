<?xml version="1.0" encoding="utf-8"?>
<!-- 局域网服务弹窗(设置页「局域网服务」打开时自动弹一次;标题长按随时再看):
     回答"开了之后我该从哪个地址访问" —— 设置行只有"标题 + 开关"一行,手机端没有位置放地址,
     所以地址、状态、注意事项全部收在这个弹窗里(见 LanServerDialog)。
     结构与 dialog_text_tip 一致:标题/正文在 weight=1 的可滚动区,按钮常显在最下面。
     注意列表/滚动区保留内边距 + clipToPadding=false(AGENTS §六.7)。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="20dp"
    android:paddingBottom="20dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvLanTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lan_server_title"
                android:textColor="@color/text_foreground"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- 状态行:已生效 / 开了但还要重启 / 未开启(配色在代码里按状态设,见 LanServerDialog) -->
            <TextView
                android:id="@+id/tvLanState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvLanLead"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="6dp"
                android:text="@string/lan_server_lead"
                android:textColor="@color/text_foreground" />

            <!-- 地址块:同一个面(bg_surface 圆角卡),地址行(item_lan_addr)由代码按实际地址逐个加入 -->
            <LinearLayout
                android:id="@+id/llLanAddrBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_large_round_float"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvLanAddrEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="6dp"
                    android:text="@string/lan_server_addr_empty"
                    android:textColor="@color/text_sub_foreground"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 说明入口:整段"用它做什么…"铺在这里太碍眼(用户口径),收成一行可点文字,
                 点开用同一个 TextTipDialog 看全文 —— 与设置行标题长按看到的是同一份文案。
                 这一行靠右排(layout_gravity=end):它是弹窗里的"附加入口",不参与左侧的
                 标题/状态/地址那条左对齐阅读线,贴右下角才不会看着像正文的一部分 -->
            <LinearLayout
                android:id="@+id/llLanHelp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="12dp"
                android:background="?selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="2dp">

                <TextView
                    android:id="@+id/tvLanHelp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lan_server_help"
                    android:textColor="@color/text_highlight"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginStart="2dp"
                    android:contentDescription="@string/lan_server_help"
                    android:src="@drawable/ic_seek_right"
                    app:tint="@color/text_highlight" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 两个按钮并排、等宽、按 weight 吃掉整排(「立即重启应用」隐藏时「知道了」自动占满整排);
         顺序与其它弹窗一致:次要动作在左、主动作在右 -->
    <LinearLayout
        android:id="@+id/llLanActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLanRestart"
            style="@style/BtnPrimary"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:paddingHorizontal="6dp"
            android:text="@string/lan_server_restart"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLanOk"
            style="@style/BtnPrimary"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="@string/lan_server_ok" />
    </LinearLayout>
</LinearLayout>
