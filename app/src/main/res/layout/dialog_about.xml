<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="20dp"
    android:paddingBottom="24dp"
    android:paddingHorizontal="20dp">

    <!-- 行1: 标题 + 控件(关闭) -->
    <LinearLayout
        android:id="@+id/about_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="关于"
            android:textColor="@color/text_foreground"
            android:textStyle="bold"
            android:textSize="18sp" />

        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/ic_close_24"
            android:padding="10dp" />
    </LinearLayout>

    <!-- 行2: 内容(超出则内部滚动, 上下标题/按钮固定不滚动) -->
    <ScrollView
        android:id="@+id/about_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        android:overScrollMode="always"
        app:layout_constrainedHeight="true"
        app:layout_constraintHeight_max="@dimen/dp_480"
        app:layout_constraintTop_toBottomOf="@id/about_header"
        app:layout_constraintBottom_toTopOf="@id/about_footer"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="10dp"
                android:text="@string/about"
                android:textColor="@color/text_foreground" />



            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="修改自"
                android:textColor="@color/text_foreground" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="https://github.com/XiaoRanLiu3119/TVBoxOS-Mobile"
                android:textColor="@color/text_sub_foreground"
                android:textIsSelectable="true" />
        </LinearLayout>
    </ScrollView>

    <!-- 行3: 版本 + 状态 + 检查更新按钮(固定底部, 不参与滚动) -->
    <LinearLayout
        android:id="@+id/about_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <TextView
            android:id="@+id/tv_update_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_horizontal"
            android:visibility="gone"
            tools:text="正在检查更新..."
            android:textColor="@color/text_sub_foreground"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_check_update"
            style="@style/BtnPrimary"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:text="检查更新" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
