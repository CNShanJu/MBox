<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="20dp"
    android:paddingBottom="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="直连接收端"
        android:textColor="@color/text_foreground"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="输入接收端的 IP 和端口，无需配对码。"
        android:textColor="@color/text_sub_foreground"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/cast_address_input"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_lan_import_field"
        android:hint="例如 192.168.1.10:8181"
        android:imeOptions="actionDone"
        android:inputType="textUri"
        android:maxLength="160"
        android:paddingHorizontal="14dp"
        android:singleLine="true"
        android:textColor="@color/text_foreground"
        android:textColorHint="@color/text_sub_foreground" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cast_address_cancel"
            style="@style/BtnSecondary"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="取消" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cast_address_confirm"
            style="@style/BtnPrimary"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="连接" />
    </LinearLayout>
</LinearLayout>
