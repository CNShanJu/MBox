<?xml version="1.0" encoding="utf-8"?>
<!-- 页面级面(圆角大卡片):与底部导航栏、二级页标题栏同一个面 —— bg_surface 色 + 92% 透明度
     (见 app/build.gradle 的 *_alpha 说明),用于"我的"页选项卡片、设置页内容块、
     各页面内容容器、背景图设置页底部面板。
     注意:大面板用半透明会把背后底图的明暗差透出来(轻微噪斑),这是"和底栏同一个面"的代价,
     已与用户确认取统一观感;若要更干净只能整体改实色或给面板加模糊层。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
	android:shape="rectangle">
	<solid
			android:color="@color/bg_surface" />

	<corners 
			android:radius="@dimen/radius_background" />

</shape>