<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <!-- 圆角:原来写死 5mm(≈19dp),放在搜索结果行上接近半高、会退化成胶囊;
                 改走主题维度 radius_card(全站统一 8dp)。描边宽度保持原样。 -->
            <corners android:radius="@dimen/radius_card" />
            <!-- 描边原来是 2mm(≈7.6dp):聚焦圈厚得盖住半行文字。改 1dp(全站按钮/聚焦圈的统一档)。 -->
            <stroke android:width="1dp" android:color="@color/md_on_primary" />
        </shape>
    </item>
    <item android:state_focused="false">
        <shape>
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
