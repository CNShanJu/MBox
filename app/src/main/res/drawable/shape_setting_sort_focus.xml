<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <!-- 与外层 bg_r_common_solid_primary 共用圆角档，焦点描边贴合实心底。 -->
            <corners android:radius="@dimen/common_corners" />
            <!-- 描边原来是 2mm(≈7.6dp):聚焦圈厚得盖住半行文字。改 1dp(全站按钮/聚焦圈的统一档)。 -->
            <stroke android:width="1dp" android:color="@color/md_on_primary" />
        </shape>
    </item>
    <item android:state_focused="false">
        <shape>
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
