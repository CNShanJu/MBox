<?xml version="1.0" encoding="utf-8"?>
<!-- 气泡(长按动作气泡、上次看到 xxx):属于**浮层**,跟弹窗/抽屉同一档透明度 ——
     底色 = bg_float(= bg_surface 的颜色 + bg_float_alpha)。
     别改回页面层的 bg_surface:那样它会跟卡片同透明度,浮起来的东西却和页面一样实,观感割裂
     (用户口径:"上次看到 xxx 的气泡框…透明度也走 [bg_float_alpha]")。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/radius_dialog" />
    <solid android:color="@color/bg_float" />
</shape>
