<?xml version="1.0" encoding="utf-8"?>
<!-- 浮层小件的面(长按动作气泡、搜索页 ⋮ 的「切换布局」气泡、上次看到 xxx、搜索联想面板):
     透明度跟弹窗/抽屉同一档 —— 底色 = bg_float(= bg_surface 的颜色 + bg_float_alpha)。
     别改回页面层的 bg_surface:那样它会跟卡片同透明度,浮起来的东西却和页面一样实,观感割裂
     (用户口径:"上次看到 xxx 的气泡框…透明度也走 [bg_float_alpha]")。
     圆角走**小件档**(@dimen/common_corners),不走面板档 @dimen/radius_dialog:
     这类东西高只有 40~50dp,而且就贴在历史/热词/联想 chip 旁边,取面板档会明显比邻居圆
     (用户口径:"历史搜索、搜索联想组件的圆角还是不对,搜索边上更换布局的 tips 也是圆角不对了")。
     具体多少 dp 以 theme_radii.json 为准,别在这里抄一份数字。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/common_corners" />
    <solid android:color="@color/bg_float" />
</shape>
