<?xml version="1.0" encoding="utf-8"?>
<!-- 直播页"选中/聚焦那一条"的底(圆角胶囊):
     底 = btn_select_bg(与纯色按钮同一个底色,**含透明度**:暗色主题下它是无色,只剩描边与白字),
     聚焦时再叠一圈 btn_select_text 描边 —— 这两个是一对("选中填充 + 其上的对比色"),亮/暗主题下都保证看得见。
     沿革:这里原来是写死的蓝 accent_on_dark(唯一还在用那支蓝的地方),按用户口径"移除,走主题"
     改成主题色;主题文件里已没有 accent_on_dark 这个键。
     注意文件名是历史遗留(它本是详情页"快速搜索"按钮的底,现在只被直播页的 item_bg_selector_right 用),
     改不改名待定 —— 别再新增第二个同用途的 drawable。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 圆角:原来写死 dp_20=20dp,放在 ~44dp 高的列表行上就是 45%
         (越过"圆角 ≥ 半高会被 GradientDrawable 缩成胶囊"的线),同屏与其它键也对不上;
         改走主题维度 radius_widget_btn(全站统一 8dp)。 -->
    <item android:state_focused="true">
        <shape>
            <corners android:radius="@dimen/radius_widget_btn" />
            <solid android:color="@color/btn_select_bg" />
            <!-- 描边原来是 2mm(≈7.6dp,全站唯一一处 mm 描边):聚焦那一圈厚得像块板子。
                 改走主题的 stroke_widget_btn(与圆角 radius_widget_btn 同一档的"小组件"口径,默认 0.5dp)。 -->
            <stroke android:width="@dimen/stroke_widget_btn" android:color="@color/btn_select_text" />
        </shape>
    </item>
    <item android:state_focused="false">
        <shape>
            <corners android:radius="@dimen/radius_widget_btn" />
            <solid android:color="@color/btn_select_bg" />
        </shape>
    </item>
</selector>
