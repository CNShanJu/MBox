<?xml version="1.0" encoding="utf-8"?>
<!-- 行/手柄点击态(胶囊高亮):给"整行可点"的行用,避免默认 selectableItemBackground 的直角高亮
     在圆角面板里显得僵硬、或边缘贴住文字。
     用法约束:把本 drawable 给行当背景时,行必须**四边内缩**(靠容器 padding,不要用负 margin 贴到容器边),
     否则高亮会撞上容器圆角被 clipToOutline 裁掉,看着"圆角没了"。
     圆角取 radius_background:44dp 高的行会被裁成胶囊(≈22dp 半径),看起来是柔和的一条,
     不与容器圆角打架(容器圆角同属主题圆角文件,别在这里写死某个 dp)。 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/gray_darker_press_alpha">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <corners android:radius="@dimen/radius_background" />
        </shape>
    </item>
</ripple>
