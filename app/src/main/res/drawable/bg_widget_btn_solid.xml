<?xml version="1.0" encoding="utf-8"?>
<!-- 小组件按钮 · 选中档:填充 = 纯色按钮的颜色(**忽略透明度**,即 btn_select_bg =
     btn_confirm_bg 的 alpha 归 100%),文字走主按钮文字(btn_confirm_text / btn_select_text)。
     按纯色按钮同一条规矩再给一圈边框线(btn_confirm_stroke = 同一个不透明色),
     于是"选中 = 一个实心的纯色按钮"这个观感与弹窗里的确定键完全一致。
     圆角同样只走 radius_widget_btn。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/btn_select_bg" />
    <stroke
        android:color="@color/btn_confirm_stroke"
        android:width="1dp" />
    <corners android:radius="@dimen/radius_widget_btn" />
</shape>
