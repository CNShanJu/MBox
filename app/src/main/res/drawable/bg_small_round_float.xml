<?xml version="1.0" encoding="utf-8"?>
<!-- 小圆角"悬浮面"(与底部导航栏同一个面):bg_float 色 + bg_float_alpha 透明度(当前 92%,
     见 app/build.gradle 的 *_alpha 说明与 assets/theme/theme_colors.json)。
     与 bg_large_round_float 同色同透明度,只是圆角取 radius_card(小条目用),
     用于搜索页左侧来源列表的选中高亮 —— 底栏/标题栏/卡片/来源选中必须是同一个面,
     不要改回不透明色(bg_gray/bg_component),否则同屏与底栏深浅不一。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
	android:shape="rectangle">
	<solid
			android:color="@color/bg_float" />

	<corners 
			android:radius="@dimen/radius_card" />

</shape>
