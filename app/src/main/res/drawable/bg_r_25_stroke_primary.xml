<?xml version="1.0" encoding="utf-8"?>
<!-- 同 bg_r_common_stroke_primary,只有圆角档不同(大面板档 radius_background)。
     边框色 = 使用方的**文字颜色** `text_foreground`(2026-10-01 口径:空心组件边框必须与文字同色;
     消费方 item_stroke_button / item_quick_search_lite 的文字都是 text_foreground)。
     线宽走主题键 stroke_widget_btn。
     历史:先用过 @color/colorPrimary(别名「强调文字」,不是边框色),后改成 @color/btn_stroke
     (= 空心按钮边框线颜色 btn_cancel_bg)—— 后者仍会和文字色脱节,本次统一到"跟文字"。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
	android:shape="rectangle">

	<stroke
			android:color="@color/text_foreground"
		android:width="@dimen/stroke_widget_btn"/>

	<corners 
			android:radius="@dimen/radius_background" />

</shape>
