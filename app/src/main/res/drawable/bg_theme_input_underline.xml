<?xml version="1.0" encoding="utf-8"?>
<!-- 主题编辑页色值/透明度输入框:只保留底部 1dp 边框线(聚焦换前景色做反馈)。
     画法与 input_dialog_api_input 同源:描边矩形用负内缩把上/左/右三边推出视图裁掉,
     只剩底边那条线(底边内缩 1dp,让 1dp 描边完整落在视图内)。
     不用 layer-list item gravity + size 画线 —— 真机上那条"线"会铺满整个输入框。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <layer-list>
            <item android:bottom="1dp" android:left="@dimen/dp_20_" android:right="@dimen/dp_20_" android:top="@dimen/dp_20_">
                <shape android:shape="rectangle">
                    <stroke android:width="1dp" android:color="@color/text_foreground" />
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:bottom="1dp" android:left="@dimen/dp_20_" android:right="@dimen/dp_20_" android:top="@dimen/dp_20_">
                <shape android:shape="rectangle">
                    <stroke android:width="1dp" android:color="@color/btn_stroke" />
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
