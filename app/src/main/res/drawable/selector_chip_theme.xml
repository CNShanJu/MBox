<?xml version="1.0" encoding="utf-8"?>
<!-- chip/预设按钮背景(跟随主题按钮色板,大圆角):
     选中 = btn_select_bg + btn_select_text,未选中 = btn_cancel_bg(暗色主题下配置成透明=无背景),
     按下 = 通用点击态。
     一律带 1dp btn_stroke 描边:浅色主题下未选中态的填充(#ECECF4)和面板几乎同色,
     没有描边就"看不到按钮/看不到圆角";选中态填充压过描边,不受影响。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/btn_select_bg" />
            <stroke android:width="1dp" android:color="@color/btn_stroke" />
            <corners android:radius="@dimen/radius_btn_large" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/gray_darker_press_alpha" />
            <stroke android:width="1dp" android:color="@color/btn_stroke" />
            <corners android:radius="@dimen/radius_btn_large" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/btn_cancel_bg" />
            <stroke android:width="1dp" android:color="@color/btn_stroke" />
            <corners android:radius="@dimen/radius_btn_large" />
        </shape>
    </item>
</selector>
