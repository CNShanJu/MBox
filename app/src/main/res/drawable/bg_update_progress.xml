<?xml version="1.0" encoding="utf-8"?>
<!-- 更新进度条(主题化):轨道=switch_track_off(两主题都可见的中性轨道色),进度=download_active,圆角。
     **进度的颜色在运行时按状态 tint**(UpdateIndicatorDialog#refresh → setProgressTintList):
     下载中/暂停=download_active 蓝、完成=download_done 绿、失败=红 —— 与同一行的状态文字同色。
     这里写的 download_active 只是初始/兜底色:以前只给文字上色、进度条写死蓝,
     下载完成后就是"一条蓝杠 + 绿字",用户口径"看着不协调"。 -->
<!-- 轨道色不用 bg_card:弹窗这个面本身就是 bg_float,而 bg_card 与 bg_float 同色(只差透明度),
     两者叠出来的轨道与弹窗底几乎同色 —— 亮色/暗色下都"看不见进度条的底"。switch_track_off 是主题里
     专给开关轨道定的中性色(亮色 #ccccd4 / 暗色 #3C3C46),跟着主题走且与进度色有明确区分。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="3dp" />
            <solid android:color="@color/switch_track_off" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="3dp" />
                <solid android:color="@color/download_active" />
            </shape>
        </clip>
    </item>
</layer-list>
