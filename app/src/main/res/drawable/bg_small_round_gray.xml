<?xml version="1.0" encoding="utf-8"?>
<!-- 小圆角"控件底":弹窗里的列表行(item_dialog_select)、页脚动作块、详情页的来源标签、
     下载卡片正面等**小块**的底 —— 走 bg_gray → bg_card(卡片底色 + 卡片透明度)。
     它跟页面卡片/面板不是一回事:页面卡片与弹窗面板走 drawable/bg_large_round_float、
     bg_dialog 那条线(= bg_surface / bg_float,同一套色+透明度)。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
	android:shape="rectangle">
	<solid
			android:color="@color/bg_gray" />

	<corners 
			android:radius="@dimen/radius_card" />

</shape>
