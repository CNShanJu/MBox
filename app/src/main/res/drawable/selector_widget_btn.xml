<?xml version="1.0" encoding="utf-8"?>
<!-- 小组件按钮 · 唯一一份底(日志分类键 / 背景图调整键 / 搜索页历史·热词·联想键 / 播放器设置键 / 粘贴键都用它):
     未选中 = **只有边框线**(btn_cancel_bg = 空心按钮边框线颜色)、无填充;
     选中   = 填充**纯色按钮的底色本身**(btn_select_bg,连透明度一起 —— 主按钮无色时选中态也无色)
              + 同色描边(btn_confirm_stroke,不透明版);
     按下   = 通用点击态(另外"点击型"整键还有 80% 透明度特效,见 ui/kit/WidgetPressEffect)。
     圆角**只走 radius_widget_btn**。
     注意:**这类键必须给足高度**(见 style/WidgetBtn 的 minHeight):圆角一旦 ≥ 高度的一半,
     GradientDrawable 会把上下圆角一起缩成胶囊 —— 那正是"上边圆角和下边圆角不一致"的根因
     (短键变胶囊、34dp 的背景图键还是真圆角,同屏两套观感)。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/btn_select_bg" />
            <stroke
                android:width="@dimen/stroke_widget_btn"
                android:color="@color/btn_confirm_stroke" />
            <corners android:radius="@dimen/radius_widget_btn" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/gray_darker_press_alpha" />
            <stroke
                android:width="@dimen/stroke_widget_btn"
                android:color="@color/btn_cancel_bg" />
            <corners android:radius="@dimen/radius_widget_btn" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="@dimen/stroke_widget_btn"
                android:color="@color/btn_cancel_bg" />
            <corners android:radius="@dimen/radius_widget_btn" />
        </shape>
    </item>
</selector>
