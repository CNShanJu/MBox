<?xml version="1.0" encoding="utf-8"?>
<!-- 主题编辑页里的"小方框":圆角 + 主题描边 + 透明填充。
     只给"色块"(v_swatch)与背景图预览容器用 —— 色块需要一个描边轮廓才看得出浅色;
     十六进制输入框不用它(输入框走底部 1dp 边框线 bg_theme_input_underline)。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- 圆角走"小件档"common_corners(8dp),**不走 radius_card** —— 本 drawable 用来画
         主题编辑页的色块(v_swatch:40×28dp),28dp 高配 16dp 圆角就是 57%,
         越过"圆角 ≥ 半高会被 GradientDrawable 缩成胶囊"的线(ThemePillShapeContractTest 已拦下)。
         面板圆角档(radius_*)是给页面卡片/抽屉面板/按钮那种体量用的,别套到 28dp 的小方块上。 -->
    <corners android:radius="@dimen/common_corners" />
    <solid android:color="@android:color/transparent" />
    <stroke
        android:width="1dp"
        android:color="@color/btn_stroke" />
</shape>
