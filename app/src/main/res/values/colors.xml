<?xml version="1.0" encoding="utf-8"?>
<resources>


    <!-- 应用强调色随文字主色 brand；text_accent 是派生资源，不单独配置。 -->
    <color name="colorPrimary">@color/text_accent</color>
    <!--CheckBox,RadioButton,SwitchCompat等一般控件的选中效果默认采用该颜色-->
    <!--    默认window窗口(activity)背景颜色(由 theme/theme_colors.json 的 bg_body 控制)-->
    <color name="windowBackground">@color/bg_body</color>

    <!-- ============ Material 3 色板(浅色,中性灰白系;主体色由 theme/theme_colors.json 控制) ============ -->
    <color name="md_primary">@color/text_accent</color>
    <color name="md_on_primary">@color/btn_select_text</color>
    <color name="md_primary_container">@color/bg_card</color>
    <color name="md_on_primary_container">@color/text_accent</color>
    <color name="md_secondary">@color/text_sub</color>
    <color name="md_on_secondary">@color/btn_select_text</color>
    <color name="md_secondary_container">@color/bg_card</color>
    <color name="md_on_secondary_container">@color/text_accent</color>
    <color name="md_tertiary">@color/text_sub</color>
    <color name="md_on_tertiary">@color/btn_select_text</color>
    <color name="md_tertiary_container">@color/bg_card</color>
    <color name="md_on_tertiary_container">@color/text_accent</color>
    <color name="md_error">#B3261E</color>
    <color name="md_on_error">#FFFFFF</color>
    <color name="md_error_container">#F9DEDC</color>
    <color name="md_on_error_container">#410E0B</color>
    <color name="md_surface">@color/bg_body</color>
    <color name="md_on_surface">@color/text_main</color>
    <color name="md_surface_variant">@color/bg_card</color>
    <color name="md_on_surface_variant">@color/text_sub</color>
    <color name="md_outline">#9CA3AF</color>
    <!-- ============ Material 3 色板结束 ============ -->

    <color name="bg_gray">@color/bg_card</color>
    <color name="gray_darker">@color/text_sub</color>
    <!--    深灰点击透明度-->
    <color name="gray_darker_press_alpha">#3C808080</color>
    <!-- 视频画面上的进度、暂停与直播提示浮层固定为 15% 白色半透明底。 -->
    <color name="player_overlay_bg">#26FFFFFF</color>

    <!--    通用颜色-->
    <color name="white">#FFFFFF</color>
    <color name="black">#000000</color>
    <color name="text_foreground">@color/text_main</color>
    <!-- 文字分级:正常/普通强调=text_main，次要=text_sub，占位=text_hint，禁用=text_disable；
         链接与空心选中高亮=text_highlight。 -->
    <color name="text_sub_foreground">@color/text_sub</color>
    <color name="light_gray_color">#e6e6e6</color>
    <!--    警示黄色-->
    <color name="warn">#ffcb6b</color>
    <color name="red">@color/swipe_red</color>

    <!-- 危险操作三色:**固定字面量**,不进主题文件、不随自定义主题走(用户口径:"删除,对应组件固定就是这个颜色")。
         以前它们是主题概念(text_danger / swipe_red / swipe_red_text),现在只在 res 里写死一次:
         text_danger    = 危险空心按钮的文字与描边、无底色危险入口文字/图标
         swipe_red      = 不可逆动作的红底(左滑删除、实心删除确认键)
         swipe_red_text = 红底上的字 -->
    <color name="text_danger">#E5484D</color>
    <color name="swipe_red">#E5484D</color>
    <color name="swipe_red_text">#FFFFFF</color>

    <color name="disable_text">@color/text_disable</color>

    <!-- bg_float(弹层/抽屉背景, 现为半透明可调) 已上移到 assets/theme/theme_colors.json 统一维护, 此处不再重复定义 -->

    <!--    制定颜色-->
    <!--    页面背景色,activity.fragment等-->

    <!--    不可用灰色颜色-->

    <color name="orange">#ff4600</color>

    <color name="color_03DAC5">#03DAC5</color>
    <!-- 搜索页「最近热搜」序号牌的前三名固定色(用户指定,不进主题文件):1=#F44747 / 2=#FF5C00 / 3=#FFB800。
         4 名往后 = **文字主色 50% 透明**(见 HotRankAdapter);这三个是"名次语义色",亮/暗主题同一套。 -->
    <color name="search_rank_top1">#F44747</color>
    <color name="search_rank_top2">#FF5C00</color>
    <color name="search_rank_top3">#FFB800</color>
    <!-- color_highlight(全局高亮/选中色)已上移到 assets/theme/theme_colors.json 统一维护,
         此处不再重复定义(重复会编译不过)。它与主按钮同色:亮色主题=页面主黑 #1F2937、
         暗色主题=#E5E7EB,开关/chip 选中/选中文字/进度条等都跟着走。
         直播页"选中/聚焦那一条频道"的底**也走主题了**:原来是写死的蓝 accent_on_dark(该键已移除),
         现在是 btn_select_bg(= 纯色按钮的底色,连透明度一起)+ 其上文字 btn_select_text(见 drawable/button_detail_quick_search 与
         res/color/live_channel_text.xml)—— 所以单靠写死色会被明暗主题拉成"白底白字"的那类问题不再有。
         左侧"分组"列那条橙 title_fouse_n(#ffce7900)本次也收掉了(改走主题 btn_select_bg,
         见 drawable/item_right_bg.xml)—— 直播页至此没有写死的聚焦色。 -->
    <color name="color_FFB6C1">#FFB6C1</color>
    <color name="color_66000000">#66000000</color>
    <color name="color_02F8E1">#02F8E1</color>
    <color name="color_6C3D3D3D">#6c3d3d3d</color>
    <color name="color_FFFFFF">@color/white</color>

    <!-- "上次看到"弹窗固定配色(不随明暗主题变化,保证两种模式下白字/白图标均清晰可读) -->

    <!-- 海报角标(评分/年份/来源)背景:压在图片上,**不随主题**（亮/暗主题保持同一个深色 + 白字，
         否则暗色主题下浅底白字和亮色主题观感不一致）;别改成 btn_select_* 那对会随主题翻转的色 -->
<color name="poster_badge_bg">#1F2937</color>

    <!-- 开关轨道(switch_track_on/off)与圆点(switch_thumb)已上移到 assets/theme/theme_colors.json:
         开启=绿(#08CA2C,两主题一致)、关闭=亮色 #ccccd4 / 暗色 #3C3C46、圆点固定白色。
         (旧的说明写的是"开启=蓝色 #1890FF",与主题文件里的实际值对不上,已按文件订正。) -->

    <!-- bg_surface(底部导航栏磨砂遮罩)与 bg_float(悬浮钮磨砂遮罩)已上移到 assets/theme/theme_colors.json
         统一维护(颜色+透明度), 生成到 theme_colors.xml, 此处不再重复定义。
         两者是"同一个悬浮面"：底部导航栏/上次观看气泡用 bg_surface，直播钮/筛选钮/更新悬浮圈用 bg_float，
         改色改透明度时必须同步(含各自的 _alpha)，否则同屏会看出深浅不一。
         bg_surface 同时是**全站"页面级面"的唯一色**:二级页标题栏(AppTitleBar 背景)、"我的"页选项卡片、
         设置页内容块、各页面内容容器与面板(drawable bg_large_round_float)全部用它 —— 底栏/标题栏/卡片
         是同色同透明度的同一个面,改一处即全站同步。
         已知取舍:大面板半透明会把背后背景图的明暗差透出来(轻微噪斑,实测浅色下通道极差约 7 级、
         32×32 小块均值极差约 4.2 级)。这是"和底栏同一个面"的代价,已与用户确认取统一观感;
         若要更干净只能整体改实色(bg_card),或给大面板加实时模糊层。 -->

    <!-- 悬浮圆钮(直播/筛选)描边色:亮色用深色主文字 40% 透明度描边,
         避免 1dp 组件色描边在白底上几乎不可见, 与页面黑底融合 -->
    <color name="fab_stroke">@color/btn_stroke</color>

</resources>
