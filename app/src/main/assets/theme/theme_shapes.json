      "pressed": { "fill": "transparent", "stroke": "btn_plain_text" },
      "default": { "fill": "transparent", "stroke": "btn_plain_text" }
    }
  },
  "theme_btn_primary": {
    "radius": "radius_btn",
    "strokeWidthDp": 1,
