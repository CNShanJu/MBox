{
  "desc": {
    "version": "配置格式版本，当前为 1。",
    "holidays": "节日与二十四节气条目数组；公历和农历条目使用完全相同的字段。",
    "id": "稳定且唯一的规则标识，供日志、记录和排查使用；不要随意改名。",
    "name": "显示在“我的”页顶部的名称；同日多个可显示名称用“·”连接。",
    "entry.desc": "单条节日或节气的简短介绍，不参与日期计算。",
    "type": "日期历法：solar 为公历，lunar 为农历；仅匹配算法不同，其余配置结构相同。",
    "month": "月份，1 到 12；solar 按公历月，lunar 按农历月。",
    "day": "起始日；fixed 使用 1 起的日数，last_day 和 solar_term 固定为 0。",
    "endDay": "结束日（包含）；单日与 day 相同，范围节日可大于 day；last_day 和 solar_term 为 0。",
    "dateRule": "匹配规则：fixed 为日期/日期范围，last_day 为当月最后一天，solar_term 为节气算法日期。",
    "term": "solar_term 时填写节气名称，其他规则填写空字符串。",
    "includeLeapMonth": "农历闰月是否也匹配；当前条目均为 false，公历条目同样保留此字段。",
    "display": "是否在“我的”页顶部显示名称；false 仍可参与烟花或后续开屏规则。",
    "displayPriority": "同日多个名称的排列优先级，数字越大越靠前；同优先级按 JSON 顺序。",
    "fireworks.enabled": "真正启动 App 且开屏结束后是否尝试播放底栏烟花；二十四节气即使设为 true 也会被程序强制忽略。",
    "fireworks.maxLaunchesPerDay": "每个本地自然日最多触发的启动轮数；0 表示不限次数。",
    "fireworks.cooldownHours": "距上一轮实际发射至少间隔的整小时数，允许 1 到 23；缺失、非整数或越界一律按 1 小时。",
    "fireworks.cooldownEnabled": "是否启用上述冷却间隔；false 表示不受间隔限制。",
    "splash.enabled": "是否启用节日专属开屏素材；目前各条均为 false，继续使用默认开屏。",
    "splash.mediaType": "素材类型：none 表示无，lottie 可由现有播放器使用，image/video 为后续扩展预留。",
    "splash.asset": "应用 assets 中的素材路径；未启用时为空字符串。",
    "rules": "同一历法重复日期规则在构建时拦截；公历与农历真实撞日允许，“我的”页按 displayPriority 拼接全部名称，烟花独立选择一条有效规则且同次启动只发一轮。"
  },
